node_modules/
dist/
.env
.env.local
.env.production
# Holds live FG UAT secrets — kept local only (.env.example is the committed template).
.env.development
*.tsbuildinfo
prisma/generated/
coverage/
# NOTE: prisma/data-snapshot.json IS tracked. The master importers hardcode
# absolute Windows paths and cannot run on the server, so the snapshot is the
# only way master data reaches a deployment. Refresh it with `npm run db:export`
# on the machine that holds the source spreadsheets.
# Regenerable script artifacts (import sidecars, live-matrix outputs/logs).
scripts/_*
# ...but the _* glob above also matches scripts/__tests__ (starts with "_") — keep the
# script test suites tracked despite that.
!scripts/__tests__/
# Local-only dev/probe scripts — not part of the deploy or any npm script.
scripts/live-matrix.ts
scripts/rc-csv.ts
scripts/rc-mock-server.ts
scripts/find-frontend-test-vehicles.ts
scripts/verify-test-vehicles.ts
scripts/_hdfc-unmatched.json
