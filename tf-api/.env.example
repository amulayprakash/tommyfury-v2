# ---- Server ----
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=mysql://root:password@localhost:3306/tf_api_dev
ALLOWED_ORIGINS=http://localhost:8080
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
ENABLE_DEBUG_PAYLOAD=false

# ---- ICICI Lombard (credentials env-only, never in DB/code) ----
ICICI_ENABLED=false
ICICI_BASE_URL=https://ilesbapigee.insurancearticlez.com
ICICI_LOGIN=
ICICI_PASSWORD=
# Base64 AES key shared by ICICI for password encryption.
ICICI_AES_KEY=
# node:crypto cipher name; exact scheme to be confirmed with ICICI.
ICICI_AES_MODE=aes-256-ecb

# ---- IFFCO-Tokio (ITGI) — credentials env-only, never in DB/code ----
# Hybrid vendor: SOAP/XML for motor, REST/JSON for CKYC + policy download; no token manager.
ITGI_ENABLED=false
ITGI_SOAP_BASE_URL=https://staging.iffcotokio.co.in/portaltest/services
ITGI_REST_BASE_URL=https://staging.iffcotokio.co.in/partner-services
# PLACEHOLDER — ITGI has not yet issued our partner code.
ITGI_PARTNER_CODE=
ITGI_PARTNER_BRANCH=
ITGI_PARTNER_SUB_BRANCH=
# Echoed back in the proposal payload's responseURL tag.
ITGI_RESPONSE_URL=
# PLACEHOLDER — Basic-auth credentials for the policy-download REST API.
ITGI_DOWNLOAD_USER=
ITGI_DOWNLOAD_PASSWORD=

# ---- HDFC ERGO (Private Car, PRODUCT_CODE 2311) ----
HDFC_ENABLED=false
HDFC_BASE_URL=https://accessuat.hdfcergo.com/cp/integration/heiintegrationservice/integration/
HDFC_SOURCE=
HDFC_CHANNEL_ID=
HDFC_CREDENTIAL=
HDFC_PRODUCT_PVTCAR=2311
HDFC_TOKEN_TTL=1500

# ---- HDFC Pehchaan e-KYC (separate service) ----
HDFC_KYC_BASE_URL=https://ekyc-uat.hdfcergo.com/e-kyc
HDFC_KYC_API_KEY=
HDFC_KYC_TOKEN_TTL=480
HDFC_KYC_RETURN_URL=

# ---- Future Generali (TCS Motor API) — credentials env-only, never in DB/code ----
FG_ENABLED=false
# API gateway base (JSON motor endpoints live under /MotorAPI/1.0.0).
FG_BASE_URL=https://uat-internal-apigw.generalicentralinsurance.com:8243
# OAuth2 token endpoint (password grant). NOTE: confirm the motor token host with FG before go-live.
FG_TOKEN_URL=https://uat-internal-apim.generalicentralinsurance.com:9443/oauth2/token
# Base64 "client_id:client_secret" sent as the Authorization: Basic header (motor product).
FG_CLIENT_BASIC=
FG_USERNAME=
FG_PASSWORD=
FG_VENDOR_CODE=Webagg
FG_AGENT_CODE=60001464
FG_BRANCH_CODE=10

# ---- FG CKYC (GCKYC/3.0.0) — separate WSO2 product (own client subscription) ----
# ENV-DRIVEN host — two UAT candidates exist post-rebrand; confirm which one answers before switching.
FG_CKYC_BASE_URL=https://uat-internal-apigw.generalicentralinsurance.com:8243/GCKYC/3.0.0
# CKYC OAuth2 token endpoint (may differ from motor; defaults to FG_TOKEN_URL when unset).
FG_CKYC_TOKEN_URL=
# Base64 client for the CKYC product (distinct subscription from motor).
FG_CKYC_CLIENT_BASIC=
# Dedicated CKYC resource-owner login; falls back to FG_USERNAME/FG_PASSWORD when unset.
FG_CKYC_USERNAME=
FG_CKYC_PASSWORD=
# Static gateway subscription key sent as the `Token` header on CKYC calls.
FG_CKYC_SUBSCRIPTION_TOKEN=
# Absolute URL the eKYC portal returns the browser to after manual KYC.
FG_CKYC_RETURN_URL=

# ---- FG Motor Renewal (Renewal/1.0.0/RenewalModify) — full-JSON 3-op product ----
# Separate WSO2 product (GCMotorRenewalAPI); PROD URL not in the kit yet — confirm with FG before go-live.
FG_RENEWAL_BASE_URL=https://uat-internal-apigw.generalicentralinsurance.com:8243/Renewal/1.0.0/RenewalModify
FG_RENEWAL_TOKEN_URL=
# MUST be the GCMotorRenewalAPI subscription's consumer Basic — a DIFFERENT WSO2 product from motor.
FG_RENEWAL_CLIENT_BASIC=

# ---- FG Health (TCS BO Service) — separate WSO2 product/subscription ----
# Gates health provider registration (in addition to FG_ENABLED).
FG_HEALTH_ENABLED=false
# Health SOAP service base (the BO/Service.svc gateway path).
FG_HEALTH_BASE_URL=https://uat-internal-apigw.generalicentralinsurance.com:8243/Health/1.0.0/BO/Service.svc
# Health OAuth2 token endpoint (defaults to FG_TOKEN_URL when unset).
FG_HEALTH_TOKEN_URL=
# Base64 client for the health product (distinct subscription from motor).
FG_HEALTH_CLIENT_BASIC=
# Health agent code (samples use 60000272; falls back to FG_AGENT_CODE).
FG_HEALTH_AGENT_CODE=

# ---- FG Web-Aggregator payment gateway (checksum-signed form POST, v1.41) ----
# Hosted payment page the signed form POSTs to (WebAggPayNew.aspx, v1.41).
FG_PAYMENT_URL=https://digiuat.generalicentralinsurance.com/Ecom_UAT/WEBAPPLN/UI/Common/WebAggPayNew.aspx
# PaymentOption code: 1=PayTm, 2=HDFC, 3=PayU (PayU is mandated for web-agg).
FG_PAYMENT_OPTION=3
# "1" = PHP mode (plaintext result params, 12-field checksum); blank/"0" = .NET mode (DES-encrypted, 11-field).
FG_PAYMENT_VENDOR=1
# Absolute URL FG redirects back to after payment (our /payment/callback).
FG_PAYMENT_RESPONSE_URL=
# Reserved: FG's documented CheckSum is unsalted SHA-256 (see payment.ts).
FG_PAYMENT_CHECKSUM_SECRET=
FG_PAYMENT_SUCCESS_URL=
FG_PAYMENT_FAILURE_URL=
# Server-side reconciliation endpoint (FetchTRNDetails), v1.41.
FG_PAYMENT_RECON_URL=https://pg.generalicentralinsurance.com/quick_pay/quickpay/comservice.asmx
FG_PAYMENT_RECON_SOURCE=webaggregator
# Which id FetchTRNDetails is keyed by ("tid" | "wsPId"); UNVERIFIED — confirm on live UAT.
FG_PAYMENT_RECON_KEY=tid
# Hard-blocks issuance when recon fails; keep false until FG_PAYMENT_RECON_KEY is confirmed live.
FG_PAYMENT_RECON_ENFORCE=false

# ---- LiveChek break-in / inspection (third-party REST) ----
LIVECHEK_BASE_URL=https://newapi.test.livechek.com/api
LIVECHEK_APP_KEY=
LIVECHEK_COMPANY_ID=
LIVECHEK_APP_ID=
