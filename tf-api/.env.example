# .env holds SERVER WIRING + SECRETS ONLY.
#
# Everything else a vendor needs — gateway hosts, product/agent/partner codes,
# token TTLs, payment options, which providers are enabled — is provider DATA and
# lives in code:
#
#   src/providers/fg/config.ts      FG_ENABLED, FG_GATEWAY, FG_CHANNEL, FG_PAYMENT,
#                                   FG_HEALTH_ENABLED, LIVECHEK_BASE_URL
#   src/providers/icici/config.ts   ICICI_ENABLED, ICICI_GATEWAY
#   src/providers/hdfc/config.ts    HDFC_ENABLED, HDFC_GATEWAY
#   src/providers/itgi/config.ts    ITGI_ENABLED, ITGI_GATEWAY
#   src/config/app-urls.ts          our own origins (vendor callback / return URLs)
#
# Those values are NOT env-overridable — setting FG_BASE_URL here does nothing.
# Rule of thumb: if leaking it would be a security incident, it goes in this file;
# otherwise it goes in the provider's config.ts.

# ---- Server ----
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=mysql://root:password@localhost:3306/tf_api_dev
ALLOWED_ORIGINS=http://localhost:8080
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
ENABLE_DEBUG_PAYLOAD=false

# ---- Future Generali (TCS Motor API) ----
# Base64 "client_id:client_secret" for the motor product's WSO2 subscription.
FG_CLIENT_BASIC=
FG_USERNAME=
FG_PASSWORD=
# CKYC (GCKYC/3.0.0) — its own WSO2 subscription and its own resource-owner
# login; each falls back to the motor value above when left blank.
FG_CKYC_CLIENT_BASIC=
FG_CKYC_USERNAME=
FG_CKYC_PASSWORD=
# Static gateway subscription key sent as the `Token` header on CKYC calls.
FG_CKYC_SUBSCRIPTION_TOKEN=
# MUST be the GCMotorRenewalAPI subscription's consumer Basic — a DIFFERENT WSO2
# product from motor. Left blank, renewal tokens are minted against the motor
# subscription and every RenewalModify call 401/403s.
FG_RENEWAL_CLIENT_BASIC=
# Base64 client for the health product (distinct subscription from motor).
FG_HEALTH_CLIENT_BASIC=
# Reserved: FG's documented payment CheckSum is unsalted SHA-256 (see fg/payment.ts).
FG_PAYMENT_CHECKSUM_SECRET=

# ---- ICICI Lombard ----
ICICI_LOGIN=
ICICI_PASSWORD=
# Base64 AES key shared by ICICI for password encryption. Leave blank when
# ICICI_PASSWORD is already an encrypted value (it is then sent verbatim).
ICICI_AES_KEY=

# ---- HDFC ERGO ----
# Base64 "user:password" for the HEI token call.
HDFC_CREDENTIAL=
# Pehchaan e-KYC API key (separate service, separate JWT).
HDFC_KYC_API_KEY=

# ---- IFFCO-Tokio (ITGI) ----
# HTTP Basic credentials for ALL ITGI REST services (CKYC, master data, download).
ITGI_DOWNLOAD_USER=
ITGI_DOWNLOAD_PASSWORD=

# ---- LiveChek break-in / inspection ----
LIVECHEK_APP_KEY=
LIVECHEK_COMPANY_ID=
LIVECHEK_APP_ID=
