# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- MySQL (tf_api_dev - hdfcmmv model lookup) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=tf_api_dev

# ---- HDFC ERGO channel credentials (UAT) ----
HDFC_BASE_URL=https://accessuat.hdfcergo.com/cp/integration/heiintegrationservice/integration/
HDFC_SOURCE=NOVACRED
HDFC_CHANNEL_ID=NOVA0001
HDFC_CREDENTIAL=your_channel_password_here

# Product codes (from HDFC ERGO). Private Car = 2311.
# Two-wheeler / commercial: PLACEHOLDER codes (0000) so the flow is enabled for
# testing. HDFC will reject these as invalid — replace with real codes when
# received. This is intentional per "Option B" (test flow now, real quote later).
HDFC_PRODUCT_PVTCAR=2311
HDFC_PRODUCT_TWOWHEELER=0000
# Commercial: either ONE shared code, or separate GCV/PCV codes below.
HDFC_PRODUCT_COMMERCIAL=
HDFC_PRODUCT_GCV=0000
HDFC_PRODUCT_PCV=0000

# ---- Pehchaan e-KYC (separate service) ----
HDFC_KYC_BASE_URL=https://ekyc-uat.hdfcergo.com/e-kyc
HDFC_KYC_API_KEY=your_kyc_api_key_from_kit_email
HDFC_KYC_TOKEN_TTL=480

# Token cache safety margin (seconds) before expiry
HDFC_TOKEN_TTL=1500
