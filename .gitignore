# ---- Dependencies ----
node_modules/

# ---- Build output ----
dist/
dist-ssr/
build/
*.tsbuildinfo

# ---- Env: ignore local & secret env files; keep .env.example and committed per-env templates ----
.env
.env.local
.env.*.local
# Per-environment files are written ON the machine that runs there and must never
# be committed. tf-web/.env.production in particular is required by deploy.sh, so
# leaving it untracked-but-visible made `git status` dirty and blocked every deploy.
.env.production
.env.development

# ---- Prisma generated client (regenerated via prisma generate) ----
**/prisma/generated/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Test coverage ----
coverage/

# ---- OS / Editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

dev-down.ps1
dev-up.ps1